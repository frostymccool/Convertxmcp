# ---------------------------------------------------------------------------
# convertx-mcp-server configuration
#
# Copy to .env and edit.
#
# WHICH VARIABLES DOES docker-compose.yml ACTUALLY READ FROM THIS FILE?
# Only two:
#   CONVERTX_EMAIL          the ConvertX account this server logs in as
#   CONVERTX_JWT_SECRET     passed through to the ConvertX container
# Everything else in this file is set directly in docker-compose.yml, and the
# password comes from ./secrets/convertx_password, not from here. The full list
# below is for running the server WITHOUT compose (systemd, bare node, stdio).
#
# Every CONVERTX_* secret can instead be supplied as <NAME>_FILE pointing at a
# file, which is preferable on a shared box:
#   CONVERTX_PASSWORD_FILE=/run/secrets/convertx_password
# ---------------------------------------------------------------------------

# --- Used by docker-compose.yml (required) ----------------------------------
CONVERTX_EMAIL=mcp@home.lan

# ConvertX reads JWT_SECRET from the environment ONLY (no _FILE variant). If it
# is unset, ConvertX generates a new one on every boot and silently logs this
# server out after each restart. Generate with: openssl rand -hex 32
CONVERTX_JWT_SECRET=change-me-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Everything below is for NON-compose deployments. docker-compose.yml already
# sets these itself; changing them here will have no effect on the compose run.
# ---------------------------------------------------------------------------

# --- Where ConvertX lives (required) ----------------------------------------
# Host port 2310 in the default compose stack. Inside the compose network the
# MCP container instead reaches it at http://convertx:3000.
CONVERTX_BASE_URL=http://192.168.1.50:2310

# Only set this if ConvertX itself runs with WEBROOT set.
#CONVERTX_WEBROOT=

# --- Authentication ---------------------------------------------------------
# Supply BOTH of these, or NEITHER plus CONVERTX_UNAUTHENTICATED=true.
#CONVERTX_EMAIL=mcp@home.lan
#CONVERTX_PASSWORD=change-me

# Set to true only if your ConvertX runs with ALLOW_UNAUTHENTICATED=true.
#CONVERTX_UNAUTHENTICATED=false

# --- File access ------------------------------------------------------------
# Colon-separated directories this server may READ. Empty (the default) means
# files can only be supplied inline as base64.
CONVERTX_ALLOWED_INPUT_DIRS=/data/input

# Where converted files are written.
CONVERTX_OUTPUT_DIR=/data/output

# Largest file accepted, in bytes (default 512 MiB).
#CONVERTX_MAX_FILE_BYTES=536870912

# --- Timeouts ---------------------------------------------------------------
#CONVERTX_REQUEST_TIMEOUT_MS=30000
#CONVERTX_POLL_INTERVAL_MS=1000
# Raise this for large video transcodes.
#CONVERTX_CONVERT_TIMEOUT_MS=300000

# --- MCP transport ----------------------------------------------------------
# stdio: the client spawns this process. http: long-lived service on the LAN.
MCP_TRANSPORT=http
# 127.0.0.1 keeps it local. Use 0.0.0.0 to serve the rest of the house, and put
# it behind your LAN firewall — this server has no authentication of its own.
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=2300
